# Copy to .env. `make seed` refuses to run when ENVIRONMENT=production.

ENVIRONMENT=development
DEBUG=true
API_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000

# --- database ---------------------------------------------------------------
# Two DSNs on purpose.
#
# DATABASE_DSN is the application. It must NOT own any table, or row-level
# security stops applying to it. `make check-rls` fails the build if it does.
DATABASE_DSN=postgresql+asyncpg://workbench:workbench@localhost:5433/workbench
# DATABASE_ADMIN_DSN owns the tables and is used by Alembic only.
DATABASE_ADMIN_DSN=postgresql+asyncpg://workbench_admin:workbench_admin@localhost:5433/workbench
REDIS_DSN=redis://localhost:6380/0

# --- auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-replace-me-with-48-random-bytes-000000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_MIN_LENGTH=12

# --- billing ----------------------------------------------------------------
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON map of plan code to Stripe price id:
#   STRIPE_PRICE_IDS={"team":"price_123","enterprise":"price_456"}
STRIPE_PRICE_IDS={}

# --- email ------------------------------------------------------------------
SMTP_URL=smtp://localhost:1025
MAIL_FROM=workbench <hello@workbench.test>

# --- observability ----------------------------------------------------------
# Points at the stack in ../observability-stack
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
LOG_JSON=true
